#!/bin/bash

# provide ROOT_UUID parameter to avoid using findmnt
# (this is a workaround for chboot-partroller ...)
if echo "x${1}" |grep -q "^x--ROOT_UUID=" ; then
	ROOT_UUID="${1#*=}"
fi
[ "$ROOT_UUID" ] || ROOT_UUID="$(findmnt -no UUID /)"

BOOT_DIRECTORY="/chboot/lliurex-chboot/boot/"
ALREADY_MOUNTED="$(chbootmgr mount)"
 
if [ -d "$BOOT_DIRECTORY" ]; then
	# TODO: make some additional chboot checks ...
	cat <<EOF> /chboot/lliurex-chboot/boot/grub/grub.cfg

search.fs_uuid $ROOT_UUID root
search.fs_label chboot chboot

if [ -e (\$root)/boot/grub/grub.cfg ]; then
	set prefix=(\$root)"/boot/grub"
	configfile \$prefix/grub.cfg
else
	set forcechboot="yes"
	source (\$chboot)/lliurex-chboot/boot/chboot.cfg
fi

EOF

else
	# revert to standard boot dir
	BOOT_DIRECTORY="/boot/"
fi

grub-install --boot-directory=$BOOT_DIRECTORY --efi-directory=/boot/efi 
update-grub

[ "$ALREADY_MOUNTED="Y" ] || chbootmgr umount

