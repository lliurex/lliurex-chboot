# chboot restore image script
#
# parse additional boot parameters outside functions
# to create global vars

export CHB_EFI=
export CHB_DEV=
export CHB_GRUB=
export ROOT_DEV=
export CHB_DIR=
export CHB_FLAGS=
export CHB_IMG_BASE="chboot-image"
export CHB_IMG_NAME=""
export CHB_IMG_FILE=""
export CHB_IMG_EXTS="zst"
export chbmnt=/chboot
export efimnt=/efi

# Parse chboot specific command line options
# outside functions to create global vars
for x in $(cat /proc/cmdline); do
        case $x in
        chb.efi=*) 
                CHB_EFI=${x#chb.efi=}
                ;;
        chb.dev=*) 
                CHB_DEV=${x#chb.dev=}
                ;;
        chb.dir=*) 
                CHB_DIR=${x#chb.dir=}
                ;;
        chb.grub=*) 
                CHB_GRUB=${x#chb.grub=}
                ;;
        chb.img=*) 
                CHB_IMG_NAME=${x#chb.img=}
                ;;
        esac
done

for v in "$CHB_EFI" "$CHB_DEV" "$CHB_DIR" ; do
	[ "${v}" ] || panic "Boot arguments must include chb.efi=, chb.dev= and chb.dir= parameters. Dropping to a shell!"
done

chboot_reboot(){
#	TODO: find a better way to do this task ...
#	      kexec from kexec-tools ???

	echo b >/proc/sysrq-trigger
}

local_top()
{
	if [ "${local_top_used}" != "yes" ]; then
		[ "${quiet?}" != "y" ] && log_begin_msg "Running /scripts/local-top"
		run_scripts /scripts/local-top
		[ "$quiet" != "y" ] && log_end_msg
	fi
	local_top_used=yes
}

local_block()
{
	[ "${quiet?}" != "y" ] && log_begin_msg "Running /scripts/local-block"
	run_scripts /scripts/local-block "$@"
	[ "$quiet" != "y" ] && log_end_msg
}

chboot_premount()
{
	if [ "${chboot_premount_used}" != "yes" ]; then
		[ "${quiet?}" != "y" ] && log_begin_msg "Running /scripts/chboot-premount"
		run_scripts /scripts/chboot-premount
		[ "$quiet" != "y" ] && log_end_msg
	fi
	for d in $chbmnt $efimnt ; do
		[ -d "$d" ] || mkdir -m 0700 "$d"
	done
	chboot_premount_used=yes
}

chboot_bottom(){
	return
}

# $1=device ID to mount
# $2=optionname (for root and etc)
# $3=panic if device is missing (true or false, default: true)
# Sets $DEV to the resolved device node
local_device_setup()
{
	local dev_id="$1"
	local name="$2"
	local may_panic="${3:-true}"
	local real_dev
	local time_elapsed
	local count

	# If wait-for-root understands this prefix, then use it to wait for
	# the device rather than settling the whole of udev.

	# Timeout is max(30, rootdelay) seconds (approximately)
	local slumber=30
	case $DPKG_ARCH in
		powerpc|ppc64|ppc64el)
			slumber=180
			;;
		*)
			slumber=30
			;;
	esac
	if [ "${ROOTDELAY:-0}" -gt $slumber ]; then
		slumber=$ROOTDELAY
	fi

	case "$dev_id" in
	UUID=*|LABEL=*|PARTUUID=*|/dev/*)
		FSTYPE=$( wait-for-root "$dev_id" "$slumber" )
		;;
	*)
		wait_for_udev 10
		;;
	esac

	# Load ubi with the correct MTD partition and return since fstype
	# doesn't work with a char device like ubi.
	if [ -n "$UBIMTD" ]; then
		/sbin/modprobe ubi "mtd=$UBIMTD"
		DEV="${dev_id}"
		return
	fi

	# Don't wait for a device that doesn't have a corresponding
	# device in /dev and isn't resolvable by blkid (e.g. mtd0)
	if [ "${dev_id#/dev}" = "${dev_id}" ] &&
	   [ "${dev_id#*=}" = "${dev_id}" ]; then
		DEV="${dev_id}"
		return
	fi

	# If the root device hasn't shown up yet, give it a little while
	# to allow for asynchronous device discovery (e.g. USB).  We
	# also need to keep invoking the local-block scripts in case
	# there are devices stacked on top of those.
	#
	# in Ubuntu, we should never actually enter this loop as wait-for-root
	# above should have waited until the device appeared.
	if ! real_dev=$(resolve_device "${dev_id}") ||
	   ! get_fstype "${real_dev}" >/dev/null; then
		log_begin_msg "Waiting for ${name}"

		while true; do
			sleep 1
			time_elapsed="$(time_elapsed)"

			local_block "${dev_id}"

			# If mdadm's local-block script counts the
			# number of times it is run, make sure to
			# run it the expected number of times.
			mdadm_exec=0
			while true; do
				if [ -f /run/count.mdadm.initrd ]; then
					count="$(cat /run/count.mdadm.initrd)"
				elif [ -n "${count}" ]; then
					# mdadm script deleted it; put it back
					count=$((count + 1))
					echo "${count}" >/run/count.mdadm.initrd
				else
					break
				fi
				if [ "${count}" -ge "${time_elapsed}" ]; then
					break;
				fi

				# Track that mdadm was executed to force
				# cryptroot execution after the loop, see
				# LP #1879980.
				mdadm_exec=1
				/scripts/local-block/mdadm "${dev_id}"

				# Cryptroot must run here, see LP #1879980.
				# The counter is inc/dec on cryptroot script!
				if [ -f /run/cryptroot.initrd.cnt ]; then
					crypt_cnt=$(cat /run/cryptroot.initrd.cnt)
					if [ "${crypt_cnt}" -gt 0 ]; then
						/scripts/local-block/cryptroot "${dev_id}"
					fi
				fi
			done

			# Extra cryptroot run after mdadm loop in order to
			# start encrypted volumes on top of RAID arrays.
			if [ -f /run/cryptroot.initrd.cnt ]; then
				crypt_cnt=$(cat /run/cryptroot.initrd.cnt)
				if [ "${crypt_cnt}" -gt 0 ] || [ ${mdadm_exec} -ne 0 ]; then
					/scripts/local-block/cryptroot "${dev_id}"
				fi
			fi

			if real_dev=$(resolve_device "${dev_id}") &&
			   get_fstype "${real_dev}" >/dev/null; then
				wait_for_udev 10
				log_end_msg 0
				break
			fi
			if [ "${time_elapsed}" -ge "${slumber}" ]; then
				log_end_msg 1 || true
				break
			fi
		done
	fi

	# We've given up, but we'll let the user fix matters if they can
	while ! real_dev=$(resolve_device "${dev_id}") ||
	      ! get_fstype "${real_dev}" >/dev/null; do
		if ! $may_panic; then
			echo "Gave up waiting for ${name}"
			return 1
		fi
		echo "Gave up waiting for ${name} device.  Common problems:"
		echo " - Boot args (cat /proc/cmdline)"
		echo "   - Check rootdelay= (did the system wait long enough?)"
		if [ "${name}" = root ]; then
			echo "   - Check root= (did the system wait for the right device?)"
		fi
		echo " - Missing modules (cat /proc/modules; ls /dev)"
		panic "ALERT!  ${dev_id} does not exist.  Dropping to a shell!"
	done

	DEV="${real_dev}"
}

chboot_get_image(){
	CHB_IMG_LIST=""
	CHB_IMG_FILE=""
	if [ "$CHB_IMG_NAME" ] ; then
		CHB_IMG_LIST="${CHB_IMG_NAME}"
	else
		for t in $CHB_IMG_EXTS ; do
			CHB_IMG_LIST="$CHB_IMG_LIST ${CHB_IMG_BASE}.${t}"
		done
	fi
	for f in $CHB_IMG_LIST ; do
		F="${chbmnt}/${CHB_DIR}/${f}"
		[ ! -r "$F" ] || CHB_IMG_FILE="$F"
	done
	echo "$CHB_IMG_FILE"
}

chboot_restore(){
	rc=0
	IMAGE_FILE="$1"
	DEST_PART="$2"
	# preserve root partition UUID
	DEST_UUID="$(lsblk -nplo UUID $DEST_PART)"
	CAT_CMD="zstdcat"
	#TODO: Determine compression type and use apropiate tool
	
	# create log dir (partclone requires this directory)
	mkdir -p /var/log
	$CAT_CMD "$IMAGE_FILE" |partclone.restore -I -C -d -s - -o $DEST_PART || rc=$?

	#clean and resize
	[ $rc -ne 0 ] || e2fsck -f $DEST_PART || rc=$?
	[ $rc -ne 0 ] || resize2fs $DEST_PART || rc=$?

	#restore UUID
	[ $rc -ne 0 ] || tune2fs -U "$DEST_UUID" "$DEST_PART" || rc=$?
	return $rc
}

chboot_mount_root(){
	local_top
	chboot_premount

	[ "${quiet?}" != "y" ] && log_begin_msg "Starting chboot partition setup"

	# get chboot device
	local_device_setup "${CHB_DEV}" "chboot file system"
	CHB_DEV="${DEV}"

	# Get the filesystem type
	[ "${quiet?}" != "y" ] && log_begin_msg "Getting chboot partition FS type"
	CHB_FSTYPE=$(get_fstype "${CHB_DEV}")


	roflag=-r
	#roflag=-w
	

	[ "${quiet?}" != "y" ] && log_begin_msg "Checking chboot partition filesystem"
	checkfs "${CHB_DEV}" chboot "${CHB_FSTYPE}"

	# Mount chboot
	[ "${quiet?}" != "y" ] && log_begin_msg "Mounting chboot partition"
	mount ${roflag} -t "${CHB_FSTYPE}" ${CHB_FLAGS} "${CHB_DEV}" "${chbmnt?}"
	mountchboot_status="$?"
	[ $mountchboot_status -eq 0 ] || panic "Error mounting chboot partition!"
	[ "${quiet?}" != "y" ] && log_begin_msg "Getting chboot image file"
	CHB_IMG_FILE="$(chboot_get_image)"
	[ "$CHB_IMG_FILE" ] || panic "chboot image file not found"

	# get ROOT device
	if [ -z "${ROOT}" ]; then
                panic "No root device specified. Boot arguments must include a root= parameter."
        fi
        local_device_setup "${ROOT}" "root file system"
        ROOT="${DEV}"

	chboot_restore "$CHB_IMG_FILE" "$ROOT" || panic "Error restoring image file!!!"

	# Get root filesystem type and mount root
	ROOTFSTYPE="$(get_fstype "${ROOT}")"
	roflag=-w
	mount ${roflag} -t "${ROOTFSTYPE}"  ${ROOTFLAGS} "${ROOT}" "${rootmnt?}"
        mountroot_status="$?"
        [ $mountroot_status -eq 0 ] || panic "Error mounting root partition!"

	# Mount efi partition
        local_device_setup "${CHB_EFI}" "EFI partition"
        CHB_EFI="${DEV}"
	EFI_FSTYPE="$(get_fstype "${CHB_EFI}")"
	roflag=-w
	mount ${roflag} -t "${EFI_FSTYPE}" ${EFI_FLAGS} "$CHB_EFI}" "${efimnt?}"
	mountefi_status="$?"
	[ $mountefi_status -eq 0 ] || panic "Error mounting EFI partition!"
	
	# if not explicit CHB_GRUB parameter is included,
	# install grub in the 'parent' device of the root partition
	
	if [ -z "$CHB_GRUB" ] ; then
	        # get 'parent' from ROOT
	        CHB_GRUB="$(lsblk -ndo pkname "$ROOT")"
	fi

	chboot_cp_root_files || panic "Error copying files to root filesystem"
	chboot_install_grub "$CHB_GRUB" || panic "Error installing grub"
	sync
	REBOOT_DELAY=10
	echo "All done!"
	echo " Rebooting in $REBOOT_DELAY seconds"
	while [ $REBOOT_DELAY -gt 0 ] ; do
		echo " Rebooting in $REBOOT_DELAY seconds"
		sleep 1
		REBOOT_DELAY=$(( $REBOOT_DELAY -1))
	done
	chboot_reboot

}

local_mount_fs()
{
	read_fstab_entry "$1"

	local_device_setup "$MNT_FSNAME" "$1 file system"
	MNT_FSNAME="${DEV}"

	chboot_premount

	if [ "${readonly}" = "y" ]; then
		roflag=-r
	else
		roflag=-w
	fi

	if [ "$MNT_PASS" != 0 ]; then
		checkfs "$MNT_FSNAME" "$MNT_DIR" "${MNT_TYPE}"
	fi

	# Mount filesystem
	if ! mount ${roflag} -t "${MNT_TYPE}" -o "${MNT_OPTS}" "$MNT_FSNAME" "${rootmnt}${MNT_DIR}"; then
		panic "Failed to mount ${MNT_FSNAME} as $MNT_DIR file system."
	fi
}

mountroot()
{
	chboot_mount_root
}

mount_top()
{
	# Note, also called directly in case it's overridden.
	local_top
}

mount_premount()
{
	# Note, also called directly in case it's overridden.
	chboot_premount
}

mount_bottom()
{
	# Note, also called directly in case it's overridden.
	chboot_bottom
}

chboot_cp_root_files(){
	rc=0
	EFIVARS_DIR="/sys/firmware/efi/efivars"
	# test if efivarfs is already mounted
	ls -1 $EFIVARS_DIR 2>/dev/null |grep -q "." || mount -t efivarfs none $EFIVARS_DIR || rc=1

	if [ $rc -eq 0 ] ; then
		# TODO: generalize this
		# copy etc files
		for d in etc ; do
			SOURCE_DIR="$chbmnt/$CHB_DIR/$d"
			DEST_DIR="${rootmnt}/$d"
			ls -1 "$SOURCE_DIR" |while read f; do cp "$SOURCE_DIR/$f" "$DEST_DIR/$f" || rc=2 ; done
		done
	fi
	return $rc
}

chboot_install_grub(){
	DEST_DISK="$1"
	rc=0
	# do bind mounts
	for d in /dev /dev/pts /proc /sys /run $EFIVARS_DIR ; do mount --bind $d ${rootmnt}${d} || rc=1; done

	# install and update grub in chroot
	[ $rc -ne 0 ] || chroot "${rootmnt}" grub-install $DEST_DISK || rc=2
	[ $rc -ne 0 ] || chroot "${rootmnt}" update-grub || rc=3

	# umount bind  and root dir
	if [ $rc -eq 0 ] ; then
		for d in /sys/firmware/efi/efivars /run /sys /proc /dev/pts /dev /boot/efi  ; do umount ${rootmnt}${d}; done  
		umount ${rootmnt}
	fi
}

